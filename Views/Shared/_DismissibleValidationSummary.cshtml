@{
    var errors = ViewData.ModelState
        .Where(entry => string.IsNullOrEmpty(entry.Key))
        .SelectMany(entry => entry.Value.Errors)
        .Select(error => string.IsNullOrWhiteSpace(error.ErrorMessage)
            ? "Revise los datos ingresados e intente nuevamente."
            : error.ErrorMessage)
        .ToList();
}

@if (errors.Any())
{
    <div class="alert alert-danger alert-dismissible alert-compact d-flex align-items-center fade show py-2 small mb-4" role="alert">
        <ul class="mb-0 flex-grow-1">
            @foreach (var error in errors)
            {
                <li>@error</li>
            }
        </ul>
        <button type="button" class="btn-close flex-shrink-0" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
