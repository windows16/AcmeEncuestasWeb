@model AcmeEncuestasWeb.ViewModels.LlenarEncuestaViewModel
@{
    ViewBag.Title = Model.Nombre;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4" style="max-width: 760px;">
    <h1 class="h2 fw-bold">@Model.Nombre</h1>
    @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
    {
        <p class="text-muted">@Model.Descripcion</p>
    }

    @using (Html.BeginForm("Llenar", "Publico", new { id = Model.LinkUnico }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.Partial("_DismissibleValidationSummary")

        for (var i = 0; i < Model.Campos.Count; i++)
        {
            var campo = Model.Campos[i];
            var tipo = campo.TipoCampoId == 2 ? "number" : campo.TipoCampoId == 3 ? "date" : "text";
            <div class="mb-3">
                <label for="Campos_@(i)__Valor" class="form-label fw-semibold">
                    @campo.TituloCampo
                    @if (campo.EsRequerido)
                    {
                        <span class="text-danger">*</span>
                    }
                </label>
                <input type="hidden" name="Campos[@i].CampoId" value="@campo.CampoId" />
                <input id="Campos_@(i)__Valor"
                       name="Campos[@i].Valor"
                       type="@tipo"
                       class="form-control"
                       value="@campo.Valor"
                       step="any"
                       @(campo.EsRequerido ? "required" : "") />
                @Html.ValidationMessage("Campos[" + i + "].Valor", "", new { @class = "text-danger small" })
            </div>
        }

        <button type="submit" class="btn btn-primary">Enviar respuesta</button>
    }
</div>
