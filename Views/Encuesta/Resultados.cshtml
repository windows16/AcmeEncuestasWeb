@model AcmeEncuestasWeb.ViewModels.ResultadosViewModel
@{
    ViewBag.Title = "Resultados - " + Model.Nombre;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <a href="@Url.Action("Index", "Encuesta")" class="small text-muted text-decoration-none">&larr; Volver a mis encuestas</a>
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mt-2 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1">@Model.Nombre</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
            {
                <p class="text-muted mb-0">@Model.Descripcion</p>
            }
        </div>
        <div class="text-md-end">
            <div class="fw-semibold">
                @if (string.IsNullOrEmpty(Model.TerminoBusqueda))
                {
                    <text>@Model.TotalRespuestas respuestas</text>
                }
                else
                {
                    <text>@Model.TotalRespuestas resultados para "@Model.TerminoBusqueda"</text>
                }
            </div>
            @if (Model.TotalRespuestas > 0)
            {
                <div class="small text-muted">Página @Model.PaginaActual de @Model.TotalPaginas</div>
            }
            <a href="@Model.UrlPublica" target="_blank" rel="noopener">Abrir encuesta pública</a>
        </div>
    </div>

    <form method="get" action="@Url.Action("Resultados", "Encuesta", new { id = Model.EncuestaId })" class="mb-4">
        <div class="input-group">
            <input type="search" name="busqueda" value="@Model.TerminoBusqueda" class="form-control"
                   placeholder="Buscar en todas las respuestas..." aria-label="Buscar en todas las respuestas" />
            <button type="submit" class="btn btn-primary">Buscar</button>
            @if (!string.IsNullOrEmpty(Model.TerminoBusqueda))
            {
                <a class="btn btn-outline-secondary" href="@Url.Action("Resultados", "Encuesta", new { id = Model.EncuestaId })">Limpiar</a>
            }
        </div>
    </form>

    @if (Model.Filas.Count == 0)
    {
        <div class="alert alert-info">
            @(string.IsNullOrEmpty(Model.TerminoBusqueda)
                ? "Esta encuesta aún no tiene respuestas."
                : "No se encontraron respuestas que coincidan con la búsqueda.")
        </div>
    }
    else
    {
        <div class="table-responsive card border-0 shadow-sm">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        @foreach (var columna in Model.Columnas)
                        {
                            <th>@columna.TituloCampo</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in Model.Filas)
                    {
                        <tr>
                            <td class="text-nowrap">@fila.FechaRespuesta.ToString("dd/MM/yyyy HH:mm")</td>
                            @foreach (var columna in Model.Columnas)
                            {
                                <td>
                                    @(fila.ValoresPorCampo.TryGetValue(columna.CampoId, out var valor) ? valor : "")
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        if (Model.TotalPaginas > 1)
        {
            <nav aria-label="Paginación de resultados" class="mt-3">
                <ul class="pagination justify-content-end">
                    <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                        @if (Model.PaginaActual <= 1)
                        {
                            <span class="page-link">Anterior</span>
                        }
                        else
                        {
                            <a class="page-link" href="@Url.Action("Resultados", "Encuesta", new { id = Model.EncuestaId, pagina = Model.PaginaActual - 1, busqueda = Model.TerminoBusqueda })">Anterior</a>
                        }
                    </li>
                    <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                        @if (Model.PaginaActual >= Model.TotalPaginas)
                        {
                            <span class="page-link">Siguiente</span>
                        }
                        else
                        {
                            <a class="page-link" href="@Url.Action("Resultados", "Encuesta", new { id = Model.EncuestaId, pagina = Model.PaginaActual + 1, busqueda = Model.TerminoBusqueda })">Siguiente</a>
                        }
                    </li>
                </ul>
            </nav>
        }
    }
</div>
