@model AcmeEncuestasWeb.ViewModels.ResultadosViewModel
@{
    ViewBag.Title = "Resultados - " + Model.Nombre;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <a href="@Url.Action("Index", "Encuesta")" class="small text-muted text-decoration-none">&larr; Volver a mis encuestas</a>
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mt-2 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1">@Model.Nombre</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
            {
                <p class="text-muted mb-0">@Model.Descripcion</p>
            }
        </div>
        <div class="text-md-end">
            <div class="fw-semibold">@Model.TotalRespuestas respuestas</div>
            <a href="@Model.UrlPublica" target="_blank" rel="noopener">Abrir encuesta pública</a>
        </div>
    </div>

    @if (Model.Filas.Count == 0)
    {
        <div class="alert alert-info">Esta encuesta aún no tiene respuestas.</div>
    }
    else
    {
        <div class="table-responsive card border-0 shadow-sm">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        @foreach (var columna in Model.Columnas)
                        {
                            <th>@columna.TituloCampo</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in Model.Filas)
                    {
                        <tr>
                            <td class="text-nowrap">@fila.FechaRespuesta.ToString("dd/MM/yyyy HH:mm")</td>
                            @foreach (var columna in Model.Columnas)
                            {
                                <td>
                                    @(fila.ValoresPorCampo.TryGetValue(columna.CampoId, out var valor) ? valor : "")
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
