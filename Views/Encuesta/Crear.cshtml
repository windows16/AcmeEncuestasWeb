@model AcmeEncuestasWeb.ViewModels.EncuestaFormViewModel
@{
    ViewBag.Title = "Crear Nueva Encuesta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4" style="max-width: 900px;">
    <!-- Encabezado -->
    <div class="mb-4">
        <a href="@Url.Action("Index", "Encuesta")" class="text-decoration-none small text-muted mb-2 d-inline-block">
            &larr; Volver al listado
        </a>
        <h2 class="fw-bold mb-1">Crear Nueva Encuesta</h2>
        <p class="text-muted small mb-0">Complete la información general y configure los campos dinámicos que se solicitarán.</p>
    </div>

    @using (Html.BeginForm("Crear", "Encuesta", FormMethod.Post, new { id = "formEncuesta", role = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.Partial("_DismissibleValidationSummary")

        <!-- Tarjeta 1: Información General -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light py-3">
                <h5 class="fw-bold mb-0 text-dark">1. Información de la Encuesta</h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    @Html.LabelFor(m => m.Nombre, new { @class = "form-label fw-semibold" }) <span class="text-danger">*</span>
                    @Html.TextBoxFor(m => m.Nombre, new { 
                        @class = "form-control", 
                        placeholder = "Ejemplo: Encuesta de Satisfacción al Cliente 2026",
                        autofocus = "autofocus"
                    })
                    @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small d-block mt-1" })
                </div>

                <div class="mb-0">
                    @Html.LabelFor(m => m.Descripcion, new { @class = "form-label fw-semibold" })
                    @Html.TextAreaFor(m => m.Descripcion, new { 
                        @class = "form-control", 
                        rows = 3, 
                        placeholder = "Breve descripción u objetivo de la encuesta (opcional)" 
                    })
                    @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger small d-block mt-1" })
                </div>
            </div>
        </div>

        <!-- Tarjeta 2: Listado de Campos Dinámicos -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">2. Listado de Campos</h5>
                <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" id="btnAgregarCampo">
                    + Agregar Campo
                </button>
            </div>
            <div class="card-body p-4">
                <p class="text-muted small mb-3">
                    Defina los campos que responderá el usuario. Puede seleccionar si cada campo es de tipo <strong>Texto</strong>, <strong>Número</strong> o <strong>Fecha</strong>, y si es obligatorio.
                </p>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle" id="tablaCampos">
                        <thead class="table-light small">
                            <tr>
                                <th style="width: 24%;">Nombre del Campo <span class="text-danger">*</span></th>
                                <th style="width: 32%;">Título en Pantalla <span class="text-danger">*</span></th>
                                <th style="width: 18%;">Tipo de Campo <span class="text-danger">*</span></th>
                                <th style="width: 10%;" class="text-center">Requerido</th>
                                <th style="width: 6%;" class="text-center"></th>
                            </tr>
                        </thead>
                        <tbody id="contenedorCampos">
                            @if (Model.Campos != null && Model.Campos.Any())
                            {
                                for (int i = 0; i < Model.Campos.Count; i++)
                                {
                                    <tr class="fila-campo">
                                        <td>
                                            <input type="text" name="Campos[@i].NombreCampo" 
                                                   class="form-control form-control-sm campo-nombre" 
                                                   placeholder="ej. Telefono" 
                                                   value="@Model.Campos[i].NombreCampo" required />
                                        </td>
                                        <td>
                                            <input type="text" name="Campos[@i].TituloCampo" 
                                                   class="form-control form-control-sm campo-titulo" 
                                                   placeholder="ej. Número de Teléfono" 
                                                   value="@Model.Campos[i].TituloCampo" required />
                                        </td>
                                        <td>
                                            <select name="Campos[@i].TipoCampoId" class="form-select form-select-sm campo-tipo">
                                                <option value="1" @(Model.Campos[i].TipoCampoId == 1 ? "selected" : "")>Texto</option>
                                                <option value="2" @(Model.Campos[i].TipoCampoId == 2 ? "selected" : "")>Número</option>
                                                <option value="3" @(Model.Campos[i].TipoCampoId == 3 ? "selected" : "")>Fecha</option>
                                            </select>
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" name="Campos[@i].EsRequerido" value="true" 
                                                   class="form-check-input campo-requerido" 
                                                   @(Model.Campos[i].EsRequerido ? "checked" : "") />
                                            <input type="hidden" name="Campos[@i].EsRequerido" value="false" />
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-link text-danger btn-sm p-0 text-decoration-none btn-eliminar-fila fs-4 lh-1" title="Quitar este campo" aria-label="Quitar este campo">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Acciones Finales -->
        <div class="d-flex justify-content-end gap-2 mb-5">
            <a href="@Url.Action("Index", "Encuesta")" class="btn btn-light px-4 border">
                Cancelar
            </a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                Guardar Encuesta y Generar Link
            </button>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Re-indexar nombres de campos dinámicos para que el ModelBinder de MVC los reciba correctamente
            function reindexarCampos() {
                $("#contenedorCampos tr.fila-campo").each(function (index) {
                    $(this).find(".campo-nombre").attr("name", "Campos[" + index + "].NombreCampo");
                    $(this).find(".campo-titulo").attr("name", "Campos[" + index + "].TituloCampo");
                    $(this).find(".campo-tipo").attr("name", "Campos[" + index + "].TipoCampoId");
                    $(this).find("input[type='checkbox'].campo-requerido").attr("name", "Campos[" + index + "].EsRequerido");
                    $(this).find("input[type='hidden']").attr("name", "Campos[" + index + "].EsRequerido");
                });
            }

            // Agregar nueva fila de campo dinámico
            $("#btnAgregarCampo").on("click", function () {
                var nuevaFila = `
                    <tr class="fila-campo">
                        <td>
                            <input type="text" class="form-control form-control-sm campo-nombre" placeholder="ej. Correo" required />
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm campo-titulo" placeholder="ej. Correo Electrónico" required />
                        </td>
                        <td>
                            <select class="form-select form-select-sm campo-tipo">
                                <option value="1">Texto</option>
                                <option value="2">Número</option>
                                <option value="3">Fecha</option>
                            </select>
                        </td>
                        <td class="text-center">
                            <input type="checkbox" value="true" class="form-check-input campo-requerido" />
                            <input type="hidden" value="false" />
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-link text-danger btn-sm p-0 text-decoration-none btn-eliminar-fila fs-4 lh-1" title="Quitar este campo" aria-label="Quitar este campo">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </td>
                    </tr>
                `;

                $("#contenedorCampos").append(nuevaFila);
                reindexarCampos();
            });

            // Eliminar fila de campo dinámico
            $("#contenedorCampos").on("click", ".btn-eliminar-fila", function () {
                if ($("#contenedorCampos tr.fila-campo").length <= 1) {
                    alert("La encuesta debe tener al menos un campo.");
                    return;
                }
                $(this).closest("tr").remove();
                reindexarCampos();
            });
        });
    </script>
}

