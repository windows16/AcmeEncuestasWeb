@model IEnumerable<AcmeEncuestasWeb.ViewModels.EncuestaItemViewModel>
@{
    ViewBag.Title = "Gestión de Encuestas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <!-- Encabezado de Sección -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Mis Encuestas</h2>
            <p class="text-muted small mb-0">Administre, configure y comparta sus encuestas dinámicas.</p>
        </div>
        <div>
            <a href="@Url.Action("Crear", "Encuesta")" class="btn btn-primary px-3 py-2 fw-semibold">
                + Nueva Encuesta
            </a>
        </div>
    </div>

    <!-- Alertas de Notificación -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Listado o Estado Vacío -->
    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <h5 class="fw-bold text-secondary mb-2">No ha creado ninguna encuesta todavía</h5>
                <p class="text-muted small mb-4">Haga clic en el botón a continuación para crear su primera encuesta con campos dinámicos.</p>
                <a href="@Url.Action("Crear", "Encuesta")" class="btn btn-primary">
                    Crear Primera Encuesta
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="mb-3">
            <label for="buscarEncuesta" class="form-label fw-semibold">Buscar encuestas</label>
            <input type="search" id="buscarEncuesta" class="form-control"
                   placeholder="Buscar por nombre o descripción..." aria-controls="tablaEncuestas" />
            <div id="estadoBusquedaEncuestas" class="form-text" aria-live="polite"></div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table id="tablaEncuestas" class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 28%;">Nombre y Descripción</th>
                            <th style="width: 30%;">Enlace Único de Llenado</th>
                            <th style="width: 14%;">Fecha Creación</th>
                            <th style="width: 10%;">Respuestas</th>
                            <th style="width: 20%;" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr data-search="@item.Nombre @item.Descripcion">
                                <td>
                                    <div class="fw-bold text-dark">@item.Nombre</div>
                                    <div class="text-muted small text-truncate" style="max-width: 300px;">
                                        @(string.IsNullOrWhiteSpace(item.Descripcion) ? "Sin descripción" : item.Descripcion)
                                    </div>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm" style="max-width: 380px;">
                                        <input type="text" class="form-control font-monospace bg-light" 
                                               value="@item.UrlPublica" readonly id="link_@item.EncuestaId" />
                                        <button class="btn btn-outline-secondary" type="button" 
                                                onclick="copiarEnlace('link_@item.EncuestaId', this)">
                                            Copiar
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <span class="small text-muted">
                                        @item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </td>
                                <td>@item.TotalRespuestas</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="@Url.Action("Resultados", "Encuesta", new { id = item.EncuestaId })"
                                           class="btn btn-outline-success" title="Consultar resultados">
                                            Resultados
                                        </a>
                                        <a href="@Url.Action("Editar", "Encuesta", new { id = item.EncuestaId })" 
                                           class="btn btn-outline-primary" title="Modificar encuesta">
                                            Editar
                                        </a>
                                        <a href="@Url.Action("Eliminar", "Encuesta", new { id = item.EncuestaId })" 
                                           class="btn btn-outline-danger" title="Eliminar encuesta">
                                            Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        <tr id="sinCoincidenciasEncuestas" class="d-none">
                            <td colspan="5" class="text-center text-muted py-4">
                                No se encontraron encuestas que coincidan con la búsqueda.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById("buscarEncuesta");
            if (!input) return;

            var filas = Array.prototype.slice.call(
                document.querySelectorAll("#tablaEncuestas tbody tr[data-search]"));
            var sinCoincidencias = document.getElementById("sinCoincidenciasEncuestas");
            var estado = document.getElementById("estadoBusquedaEncuestas");

            input.addEventListener("input", function () {
                var termino = input.value.trim().toLocaleLowerCase();
                var visibles = 0;

                filas.forEach(function (fila) {
                    var texto = (fila.getAttribute("data-search") || "").toLocaleLowerCase();
                    var coincide = texto.indexOf(termino) !== -1;
                    fila.classList.toggle("d-none", !coincide);
                    if (coincide) visibles++;
                });

                sinCoincidencias.classList.toggle("d-none", visibles !== 0);
                estado.textContent = termino
                    ? visibles + (visibles === 1 ? " encuesta encontrada" : " encuestas encontradas")
                    : "";
            });
        })();

        function copiarEnlace(inputId, btn) {
            var input = document.getElementById(inputId);
            if (!input) return;

            input.select();
            input.setSelectionRange(0, 99999);

            navigator.clipboard.writeText(input.value).then(function () {
                var textoOriginal = btn.innerText;
                btn.innerText = "¡Copiado!";
                btn.classList.remove("btn-outline-secondary");
                btn.classList.add("btn-success");

                setTimeout(function () {
                    btn.innerText = textoOriginal;
                    btn.classList.remove("btn-success");
                    btn.classList.add("btn-outline-secondary");
                }, 2000);
            }).catch(function () {
                document.execCommand("copy");
            });
        }
    </script>
}

